@model List<DiscountOffer>
@{ ViewData["Title"] = "Quản lý ưu đãi"; var now = DateTime.UtcNow; }
<div class="container page-content admin-page management-page">
    <div class="section-heading"><div><span class="section-kicker">KHUYẾN MÃI</span><h1>Ưu đãi giảm giá<span class="orange-dot">.</span></h1><p>Tạo mã giảm giá theo phần trăm hoặc số tiền để khách nhập lúc thanh toán.</p></div><a class="btn btn-primary" asp-action="Create">+ Tạo ưu đãi</a></div>
    @if (TempData["Success"] is string success) { <div class="notice success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="notice error">@error</div> }
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Mã / Tên</th><th>Mức giảm</th><th>Đơn tối thiểu</th><th>Thời gian</th><th>Lượt dùng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
        @foreach (var offer in Model)
        {
            var status = !offer.IsActive ? "Đã tắt" : now < offer.StartsAt ? "Sắp diễn ra" : now > offer.EndsAt ? "Hết hạn" : offer.UsageLimit is int limit && offer.UsedCount >= limit ? "Hết lượt" : "Đang áp dụng";
            <tr><td><strong>@offer.Code</strong><small>@offer.Name</small></td><td>@(offer.Type == "Percent" ? $"{offer.Value:N0}%" : $"{offer.Value:N0}₫") @if (offer.MaximumDiscount is decimal cap) { <small>Tối đa @cap.ToString("N0")₫</small> }</td><td>@offer.MinimumOrder.ToString("N0")₫</td><td>@offer.StartsAt.ToLocalTime().ToString("dd/MM/yyyy")<small>đến @offer.EndsAt.ToLocalTime().ToString("dd/MM/yyyy")</small></td><td>@offer.UsedCount / @(offer.UsageLimit?.ToString() ?? "∞")</td><td><span class="product-state @(offer.IsActive ? "" : "hidden")">@status</span></td><td><div class="table-actions"><a asp-action="Edit" asp-route-id="@offer.Id">Sửa</a><form asp-action="Toggle" asp-route-id="@offer.Id" method="post"><button type="submit">@(offer.IsActive ? "Tắt" : "Bật")</button></form><form asp-action="Delete" asp-route-id="@offer.Id" method="post"><button type="submit" class="management-delete">Xóa</button></form></div></td></tr>
        }
    </tbody></table></div>
    @if (Model.Count == 0) { <div class="management-empty">Chưa có mã ưu đãi. Tạo mã đầu tiên để khách có thể sử dụng khi thanh toán.</div> }
</div>
