@model List<Order>
@{ ViewData["Title"] = "Đơn hàng của tôi"; }
<div class="container page-content"><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span>Đơn hàng của tôi</div><div class="page-heading"><span class="section-kicker">TÀI KHOẢN CỦA BẠN</span><h1>Đơn hàng của tôi<span class="orange-dot">.</span></h1><p>Theo dõi hành trình sản phẩm đến tay bạn.</p></div>@if(Model.Count == 0){<div class="empty-state"><span>▤</span><h2>Bạn chưa có đơn hàng</h2><p>Khám phá sản phẩm và bắt đầu mua sắm nhé!</p><a class="btn btn-primary" asp-controller="Products" asp-action="Index">Mua sắm ngay ↗</a></div>}else{<div class="order-list">@foreach(var order in Model){<article class="order-card"><div class="order-head"><div><span>Mã đơn hàng</span><strong>@order.Code</strong></div><div><span>Ngày đặt</span><strong>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong></div><span class="status-pill">@order.Status</span></div>@foreach(var item in order.Items){<div class="order-item"><span>@item.ProductName <small>@(string.IsNullOrEmpty(item.VariantLabel) ? "" : item.VariantLabel + " · ")× @item.Quantity</small></span><strong>@((item.UnitPrice * item.Quantity).ToString("N0"))₫</strong></div>}<div class="order-total">Tổng cộng <strong>@order.Total.ToString("N0")₫</strong></div></article>}</div>}</div>
