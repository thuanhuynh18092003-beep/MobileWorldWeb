@model RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; }
<div class="container auth-wrap"><div class="auth-art"><span class="section-kicker">BẮT ĐẦU HÀNH TRÌNH</span><h1>Chọn điều bạn thích.<br/><em>Sống theo cách của bạn.</em></h1><p>Tạo tài khoản để mua sắm thuận tiện và theo dõi đơn hàng mọi lúc.</p><span class="auth-star">✦</span></div><div class="auth-panel"><span class="section-kicker">TRỞ THÀNH THÀNH VIÊN</span><h2>Tạo tài khoản</h2><p>Chỉ mất một phút để bắt đầu.</p><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="FullName">Họ và tên</label><input asp-for="FullName" placeholder="Nguyễn Văn A"/><span asp-validation-for="FullName" class="validation"></span></div><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" placeholder="email@example.com"/><span asp-validation-for="Email" class="validation"></span></div><div class="field"><label asp-for="Password">Mật khẩu</label><input asp-for="Password" type="password" placeholder="Ít nhất 8 ký tự"/><span asp-validation-for="Password" class="validation"></span></div><div class="field"><label asp-for="ConfirmPassword">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" type="password" placeholder="Nhập lại mật khẩu"/><span asp-validation-for="ConfirmPassword" class="validation"></span></div><button class="btn btn-primary full-width" type="submit">Tạo tài khoản ↗</button></form><div class="auth-footer">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
