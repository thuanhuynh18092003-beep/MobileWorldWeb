@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="container auth-wrap"><div class="auth-art"><span class="section-kicker">CHÀO MỪNG TRỞ LẠI</span><h1>Thế giới công nghệ<br/><em>trong tầm tay bạn.</em></h1><p>Đăng nhập để theo dõi đơn hàng và tiếp tục hành trình khám phá của bạn.</p><span class="auth-star">✦</span></div><div class="auth-panel"><span class="section-kicker">TÀI KHOẢN MOBILEWORLD</span><h2>Đăng nhập</h2><p>Rất vui được gặp lại bạn.</p><form asp-action="Login" method="post"><input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" placeholder="email@example.com"/></div><span asp-validation-for="Email" class="validation"></span><div class="field"><label asp-for="Password">Mật khẩu</label><input asp-for="Password" type="password" placeholder="Nhập mật khẩu"/></div><span asp-validation-for="Password" class="validation"></span><button class="btn btn-primary full-width" type="submit">Đăng nhập ↗</button></form><div class="auth-footer">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
