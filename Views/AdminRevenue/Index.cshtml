@model RevenueViewModel
@using System.Text.Json
@{ ViewData["Title"] = "Báo cáo doanh thu"; }
<div class="container page-content admin-page management-page">
    <div class="section-heading"><div><span class="section-kicker">HIỆU QUẢ KINH DOANH</span><h1>Doanh thu & đơn hàng<span class="orange-dot">.</span></h1><p>Doanh thu tính từ đơn đã hoàn thành, theo ngày hoàn thành.</p></div><div class="range-tabs"><a asp-action="Index" asp-route-days="7" class="@(Model.Days == 7 ? "active" : "")">7 ngày</a><a asp-action="Index" asp-route-days="30" class="@(Model.Days == 30 ? "active" : "")">30 ngày</a><a asp-action="Index" asp-route-days="90" class="@(Model.Days == 90 ? "active" : "")">90 ngày</a></div></div>
    <div class="revenue-stats"><div><span>Doanh thu hoàn thành</span><strong>@Model.TotalRevenue.ToString("N0")₫</strong><small>@(Model.PreviousRevenue == 0 ? "Chưa có doanh thu ở kỳ trước" : $"{(Model.RevenueChangePercent >= 0 ? "+" : "")}{Model.RevenueChangePercent:N1}% so với kỳ trước")</small></div><div><span>Đơn phát sinh</span><strong>@Model.NewOrders</strong><small>Đã đặt trong @Model.Days ngày</small></div><div><span>Đơn hoàn thành</span><strong>@Model.CompletedOrders</strong><small>Hoàn thành trong @Model.Days ngày</small></div></div>
    <section class="management-panel chart-panel"><div class="management-section-heading"><div><h2>Biến động theo ngày</h2><p>Cột: doanh thu · Đường tím: đơn phát sinh · Đường xanh: đơn hoàn thành</p></div><div class="chart-legend"><span class="legend-revenue">Doanh thu</span><span class="legend-new">Đơn phát sinh</span><span class="legend-done">Đơn hoàn thành</span></div></div><div class="chart-scroll"><canvas id="revenue-chart" role="img" aria-label="Biểu đồ cột doanh thu và đường số đơn hàng theo ngày" height="330"></canvas></div><script id="revenue-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.DaysData.Select(x => new { date = x.Date.ToString("dd/MM"), revenue = x.Revenue, newOrders = x.NewOrders, completedOrders = x.CompletedOrders })))</script></section>
    <details class="management-panel revenue-details"><summary>Xem số liệu từng ngày</summary><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Ngày</th><th>Doanh thu hoàn thành</th><th>Đơn phát sinh</th><th>Đơn hoàn thành</th></tr></thead><tbody>@foreach (var day in Model.DaysData.AsEnumerable().Reverse()) { <tr><td>@day.Date.ToString("dd/MM/yyyy")</td><td>@day.Revenue.ToString("N0")₫</td><td>@day.NewOrders</td><td>@day.CompletedOrders</td></tr> }</tbody></table></div></details>
</div>
@section Scripts { <script src="~/js/admin-revenue.js" asp-append-version="true"></script> }
