@model Product
@{ var editing = Model.Id > 0; ViewData["Title"] = editing ? "Sửa sản phẩm" : "Thêm sản phẩm"; }
<div class="container page-content admin-page"><div class="page-heading"><span class="section-kicker">QUẢN TRỊ SẢN PHẨM</span><h1>@(editing ? "Chỉnh sửa sản phẩm" : "Thêm sản phẩm mới")<span class="orange-dot">.</span></h1></div><form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post" class="form-panel admin-form"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div class="field"><label asp-for="Name">Tên sản phẩm</label><input asp-for="Name"/><span asp-validation-for="Name" class="validation"></span></div><div class="field"><label asp-for="Slug">Đường dẫn (không dấu, có dấu gạch ngang)</label><input asp-for="Slug"/><span asp-validation-for="Slug" class="validation"></span></div><div class="field"><label asp-for="Brand">Thương hiệu</label><input asp-for="Brand"/><span asp-validation-for="Brand" class="validation"></span></div><div class="field"><label asp-for="Category">Danh mục</label><input asp-for="Category"/></div><div class="field"><label asp-for="Price">Giá bán (VNĐ)</label><input asp-for="Price" type="number" min="0"/><span asp-validation-for="Price" class="validation"></span></div><div class="field"><label asp-for="OldPrice">Giá cũ (VNĐ)</label><input asp-for="OldPrice" type="number" min="0"/></div><div class="field"><label asp-for="Stock">Tồn kho</label><input asp-for="Stock" type="number" min="0"/><span asp-validation-for="Stock" class="validation"></span></div><div class="field"><label asp-for="Storage">Dung lượng</label><input asp-for="Storage"/></div><div class="field"><label asp-for="Color">Màu minh họa (mã HEX)</label><input asp-for="Color" placeholder="#d9c8b8"/></div><div class="field"><label asp-for="Screen">Màn hình</label><input asp-for="Screen"/></div><div class="field"><label asp-for="Camera">Camera</label><input asp-for="Camera"/></div><div class="field"><label asp-for="Battery">Pin</label><input asp-for="Battery"/></div><div class="field"><label asp-for="Chip">Vi xử lý</label><input asp-for="Chip"/></div><div class="field field-wide"><label asp-for="ShortDescription">Mô tả ngắn</label><input asp-for="ShortDescription"/></div><div class="field field-wide"><label asp-for="Description">Mô tả chi tiết</label><textarea asp-for="Description" rows="4"></textarea></div><div class="field field-wide checkbox-row"><label><input asp-for="IsFeatured"/> Sản phẩm nổi bật</label><label><input asp-for="IsActive"/> Đang bán</label></div></div><div class="form-actions"><button class="btn btn-primary" type="submit">Lưu sản phẩm</button><a class="btn btn-outline" asp-action="Products">Quay lại</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

