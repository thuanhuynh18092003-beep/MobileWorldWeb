@model List<Product>
@{ ViewData["Title"] = "Tổng quan quản trị"; }
<div class="container page-content admin-page">
    <div class="page-heading"><span class="section-kicker">MOBILEWORLD ADMIN</span><h1>Tổng quan cửa hàng<span class="orange-dot">.</span></h1><p>Quản lý sản phẩm, tồn kho và đơn hàng trong một nơi.</p></div>
    <div class="admin-stats">
        <div><span>Tổng sản phẩm</span><strong>@ViewBag.ProductCount</strong></div>
        <div><span>Đang bán</span><strong>@ViewBag.ActiveCount</strong></div>
        <div><span>Hết hàng</span><strong>@ViewBag.OutOfStockCount</strong></div>
        <div><span>Đơn cần xử lý</span><strong>@ViewBag.PendingOrderCount</strong></div>
    </div>
    <div class="section-heading"><div><span class="section-kicker">KIỂM TRA TỒN KHO</span><h2>Sản phẩm cần chú ý</h2></div><a class="text-arrow" asp-action="Products">Quản lý sản phẩm ↗</a></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Sản phẩm</th><th>Thương hiệu</th><th>Tồn kho</th><th>Trạng thái</th><th></th></tr></thead><tbody>
        @foreach (var product in Model)
        {
            <tr><td><strong>@product.Name</strong><small>@product.Storage</small></td><td>@product.Brand</td><td>@product.Stock</td><td><span class="product-state @(product.IsActive ? product.Stock == 0 ? "sold-out" : "" : "hidden")">@(product.IsActive ? product.Stock == 0 ? "Hết hàng" : "Đang bán" : "Đã ẩn")</span></td><td><a class="text-arrow" asp-action="Edit" asp-route-id="@product.Id">Chỉnh sửa ↗</a></td></tr>
        }
    </tbody></table></div>
    <div class="admin-next"><div><strong>Đơn hàng cần cập nhật?</strong><p>Chuyển trạng thái để theo dõi quá trình xử lý và giao hàng.</p></div><a class="btn btn-outline" asp-action="Orders">Xem trạng thái đơn hàng ↗</a></div>
</div>
