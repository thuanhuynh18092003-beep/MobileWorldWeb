@model CheckoutViewModel
@{ ViewData["Title"] = "Thanh toán"; }
<div class="container page-content">
    <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span><a asp-controller="Cart" asp-action="Index">Giỏ hàng</a><span>›</span>Thanh toán</div>
    <div class="page-heading"><span class="section-kicker">CHỈ CÒN MỘT BƯỚC</span><h1>Hoàn tất đơn hàng<span class="orange-dot">.</span></h1><p>Điền thông tin để chúng tôi giao hàng đến bạn.</p></div>
    <form asp-action="Index" method="post" class="checkout-layout">
        <div class="form-panel"><h2>Thông tin nhận hàng</h2><div asp-validation-summary="ModelOnly" class="validation"></div>
            <div class="form-grid">
                <div class="field"><label asp-for="CustomerName">Họ và tên *</label><input asp-for="CustomerName" placeholder="Nguyễn Văn A"/><span asp-validation-for="CustomerName" class="validation"></span></div>
                <div class="field"><label asp-for="Phone">Số điện thoại *</label><input asp-for="Phone" placeholder="0901234567"/><span asp-validation-for="Phone" class="validation"></span></div>
                <div class="field"><label asp-for="Email">Email *</label><input asp-for="Email" placeholder="email@example.com"/><span asp-validation-for="Email" class="validation"></span></div>
                <div class="field field-wide"><label asp-for="Address">Địa chỉ giao hàng *</label><input asp-for="Address" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành"/><span asp-validation-for="Address" class="validation"></span></div>
                <div class="field field-wide"><label asp-for="Note">Ghi chú đơn hàng</label><textarea asp-for="Note" rows="3" placeholder="Lưu ý cho người giao hàng (nếu có)"></textarea></div>
            </div>
            <h2>Phương thức thanh toán</h2>
            <div class="payment-options"><label><input type="radio" asp-for="PaymentMethod" value="COD" checked="@(Model.PaymentMethod == "COD")"/><span><strong>Thanh toán khi nhận hàng</strong><small>Kiểm tra sản phẩm, sau đó thanh toán.</small></span></label><label><input type="radio" asp-for="PaymentMethod" value="BankTransfer" checked="@(Model.PaymentMethod == "BankTransfer")"/><span><strong>Chuyển khoản ngân hàng</strong><small>Nhân viên sẽ liên hệ và cung cấp thông tin chuyển khoản.</small></span></label></div><span asp-validation-for="PaymentMethod" class="validation"></span>
        </div>
        <aside class="summary-card"><h2>Đơn hàng của bạn</h2>
            @foreach (var line in Model.Cart.Lines) { <div class="checkout-item"><span>@line.Product.Name <small>@line.Variant.ColorName · @line.Variant.Storage · × @line.Quantity</small></span><strong>@line.Total.ToString("N0")₫</strong></div> }
            <div class="offer-entry"><label asp-for="DiscountCode">Mã ưu đãi</label><div><input asp-for="DiscountCode" placeholder="Nhập mã giảm giá" autocomplete="off" /><button type="submit" name="command" value="preview" formnovalidate>Áp dụng</button></div><span asp-validation-for="DiscountCode" class="validation"></span>@if (Model.DiscountAmount > 0) { <small class="offer-success">Đã áp dụng mã @Model.DiscountCode</small> }</div>
            <div class="summary-line"><span>Tạm tính</span><strong>@Model.Cart.Total.ToString("N0")₫</strong></div>
            @if (Model.DiscountAmount > 0) { <div class="summary-line offer-discount"><span>Ưu đãi</span><strong>−@Model.DiscountAmount.ToString("N0")₫</strong></div> }
            <div class="summary-line"><span>Vận chuyển</span><strong class="free">@(Model.Cart.Total >= 5000000 ? "Miễn phí" : "Liên hệ xác nhận")</strong></div>
            <div class="summary-total"><span>Tổng cộng</span><strong>@Model.PayableTotal.ToString("N0")₫</strong></div><button class="btn btn-primary full-width" type="submit">Đặt hàng ngay ↗</button><p>Bằng việc đặt hàng, bạn đồng ý với chính sách mua hàng của chúng tôi.</p>
        </aside>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
