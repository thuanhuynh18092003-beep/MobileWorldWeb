@model Product
@using System.Text.Json
@{
    ViewData["Title"] = Model.Name;
    var related = ViewBag.Related as List<Product> ?? new();
    var variants = Model.Variants.Where(x => x.IsActive).OrderByDescending(x => x.IsDefault).ThenBy(x => x.Id).ToList();
    var selectedVariantId = ViewBag.SelectedVariantId as int?;
    var selected = variants.FirstOrDefault(x => x.Id == selectedVariantId) ?? variants.FirstOrDefault(x => x.IsDefault && x.Stock > 0) ?? variants.FirstOrDefault(x => x.Stock > 0) ?? variants.FirstOrDefault();
    var colors = variants.GroupBy(x => x.ColorName).Select(x => x.First()).ToList();
    var storages = variants.Select(x => x.Storage).Distinct().ToList();
}
<div class="container page-content">
    <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span><a asp-action="Index">Điện thoại</a><span>›</span>@Model.Name</div>
    <div class="details-grid" data-variant-selector data-selected-variant-id="@selected?.Id">
        <div class="details-visual" id="variant-visual" style="--phone-color:@(selected?.ColorHex ?? Model.Color)">
            <div class="details-image-frame">
                <img id="variant-photo" class="details-photo" src="@(selected is null ? Model.ImageUrl : selected.ImageUrl)" alt="@Model.Name @(selected?.ColorName)" hidden="@(string.IsNullOrWhiteSpace(selected is null ? Model.ImageUrl : selected.ImageUrl))" />
                <div id="variant-placeholder" class="product-photo-placeholder details-placeholder" hidden="@(!string.IsNullOrWhiteSpace(selected is null ? Model.ImageUrl : selected.ImageUrl))"><strong>@Model.Brand</strong><small>Chưa có ảnh phiên bản này</small></div>
            </div>
        </div>
        <div class="details-copy">
            <span class="section-kicker">@Model.Brand · CHÍNH HÃNG</span><h1>@Model.Name</h1>
            <div class="details-rating">✓ <span>Sản phẩm chính hãng · Bảo hành 12 tháng</span></div><p class="details-desc">@Model.ShortDescription</p>
            <div class="details-price"><strong id="variant-price">@((selected?.Price ?? Model.Price).ToString("N0"))₫</strong><del id="variant-old-price" hidden="@(selected?.OldPrice is null)">@selected?.OldPrice?.ToString("N0")₫</del></div>
            <button type="button" class="btn btn-outline details-3d-button" data-view-3d data-product-name="@Model.Name" data-product-color="@(selected?.ColorHex ?? Model.Color)" hidden>↻ Xem mô phỏng 3D</button>
            <div class="variant-picker"><strong>Phiên bản dung lượng</strong><div class="variant-options" id="storage-options">@foreach (var storage in storages) { var target = variants.FirstOrDefault(x => x.Storage == storage && x.ColorName == selected?.ColorName) ?? variants.First(x => x.Storage == storage); <a class="variant-option" data-storage="@storage" aria-pressed="@(selected?.Storage == storage)" asp-action="Details" asp-route-slug="@Model.Slug" asp-route-variantId="@target.Id">@storage</a> }</div></div>
            <div class="variant-picker"><strong>Màu sắc <span id="selected-color-name">@selected?.ColorName</span></strong><div class="variant-options" id="color-options">@foreach (var color in colors) { var target = variants.FirstOrDefault(x => x.ColorName == color.ColorName && x.Storage == selected?.Storage) ?? variants.First(x => x.ColorName == color.ColorName); <a class="variant-option color-option" data-color="@color.ColorName" aria-pressed="@(selected?.ColorName == color.ColorName)" asp-action="Details" asp-route-slug="@Model.Slug" asp-route-variantId="@target.Id"><span class="variant-swatch" style="background:@color.ColorHex"></span>@color.ColorName</a> }</div></div>
            <form asp-controller="Cart" asp-action="Add" method="post" class="details-buy"><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="variantId" id="selected-variant-id" value="@selected?.Id"/><input type="hidden" name="returnUrl" value="/gio-hang"/><div class="quantity-control"><button type="button" data-qty-minus>−</button><input id="variant-quantity" type="number" name="quantity" value="1" min="1" max="@(selected?.Stock ?? 0)" aria-label="Số lượng"/><button type="button" data-qty-plus>+</button></div><button id="variant-add-button" class="btn btn-primary" type="submit" disabled="@(selected is null || selected.Stock == 0)">@(selected is null || selected.Stock == 0 ? "Tạm hết hàng" : "Thêm vào giỏ hàng ↗")</button></form>
            <p class="stock-note" id="variant-stock">@(selected is not null && selected.Stock > 0 ? $"✓ Còn {selected.Stock} sản phẩm · Sẵn sàng giao hàng" : "Phiên bản này hiện tạm hết hàng")</p>
            <div class="details-benefits"><div>♢ <span>Chính hãng 100%</span></div><div>↗ <span>Giao hàng nhanh</span></div><div>◎ <span>Bảo hành 12 tháng</span></div></div>
        </div>
    </div>
    <div class="spec-section"><div><span class="section-kicker">TÌM HIỂU THÊM</span><h2>Thông số nổi bật</h2><p>@Model.Description</p></div><div class="spec-list"><div><span>Màn hình</span><strong>@Model.Screen</strong></div><div><span>Camera</span><strong>@Model.Camera</strong></div><div><span>Pin</span><strong>@Model.Battery</strong></div><div><span>Vi xử lý</span><strong>@Model.Chip</strong></div><div><span>Bộ nhớ</span><strong id="variant-spec-storage">@(selected?.Storage ?? Model.Storage)</strong></div></div></div>
    @if (related.Count > 0) { <section class="section related-section"><div class="section-heading"><div><span class="section-kicker">BẠN CÓ THỂ THÍCH</span><h2>Sản phẩm tương tự<span class="orange-dot">.</span></h2></div><a class="text-arrow" asp-action="Index" asp-route-brand="@Model.Brand">Xem thêm ↗</a></div><div class="product-grid">@foreach (var product in related) { <partial name="_ProductCard" model="product" /> }</div></section> }
</div>
<script id="product-variants-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(variants.Select(x => new { id = x.Id, colorName = x.ColorName, colorHex = x.ColorHex, storage = x.Storage, price = x.Price, oldPrice = x.OldPrice, stock = x.Stock, imageUrl = x.ImageUrl, isDefault = x.IsDefault })))</script>
@section Scripts { <script src="~/js/product-variants.js" asp-append-version="true"></script> }

