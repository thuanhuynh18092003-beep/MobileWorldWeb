@model Product
@{ ViewData["Title"] = Model.Name; var related = ViewBag.Related as List<Product> ?? new(); }
<div class="container page-content"><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span><a asp-action="Index">Điện thoại</a><span>›</span>@Model.Name</div><div class="details-grid"><div class="details-visual" style="--phone-color:@Model.Color"><div class="details-phone phone-art"><span class="phone-lens l1"></span><span class="phone-lens l2"></span><span class="phone-lens l3"></span><span class="phone-flash"></span><span class="phone-symbol">✦</span></div><span class="visual-caption">Thiết kế để tạo khác biệt</span></div><div class="details-copy"><span class="section-kicker">@Model.Brand · CHÍNH HÃNG</span><h1>@Model.Name</h1><div class="details-rating">✓ <span>Sản phẩm chính hãng · Bảo hành 12 tháng</span></div><p class="details-desc">@Model.ShortDescription</p><div class="details-price"><strong>@Model.Price.ToString("N0")₫</strong>@if(Model.OldPrice.HasValue){<del>@Model.OldPrice.Value.ToString("N0")₫</del>}</div><div class="details-choice"><strong>Phiên bản</strong><span>@Model.Storage</span></div><div class="details-choice"><strong>Màu sắc</strong><span class="color-dot" style="background:@Model.Color"></span><span>Phiên bản tuyển chọn</span></div><form asp-controller="Cart" asp-action="Add" method="post" class="details-buy"><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="returnUrl" value="/gio-hang"/><div class="quantity-control"><button type="button" data-qty-minus>−</button><input type="number" name="quantity" value="1" min="1" max="@Model.Stock" aria-label="Số lượng"/><button type="button" data-qty-plus>+</button></div><button class="btn btn-primary" type="submit" disabled="@(Model.Stock == 0)">@(Model.Stock == 0 ? "Tạm hết hàng" : "Thêm vào giỏ hàng ↗")</button></form><p class="stock-note">@(Model.Stock > 0 ? $"✓ Còn {Model.Stock} sản phẩm · Sẵn sàng giao hàng" : "Sản phẩm hiện tạm hết hàng")</p><div class="details-benefits"><div>♢ <span>Chính hãng 100%</span></div><div>↗ <span>Giao hàng nhanh</span></div><div>◎ <span>Bảo hành 12 tháng</span></div></div></div></div><div class="spec-section"><div><span class="section-kicker">TÌM HIỂU THÊM</span><h2>Thông số nổi bật</h2><p>@Model.Description</p></div><div class="spec-list"><div><span>Màn hình</span><strong>@Model.Screen</strong></div><div><span>Camera</span><strong>@Model.Camera</strong></div><div><span>Pin</span><strong>@Model.Battery</strong></div><div><span>Vi xử lý</span><strong>@Model.Chip</strong></div><div><span>Bộ nhớ</span><strong>@Model.Storage</strong></div></div></div>@if(related.Count > 0){<section class="section related-section"><div class="section-heading"><div><span class="section-kicker">BẠN CÓ THỂ THÍCH</span><h2>Sản phẩm tương tự<span class="orange-dot">.</span></h2></div><a class="text-arrow" asp-action="Index" asp-route-brand="@Model.Brand">Xem thêm ↗</a></div><div class="product-grid">@foreach(var product in related){<partial name="_ProductCard" model="product" />}</div></section>}</div>

