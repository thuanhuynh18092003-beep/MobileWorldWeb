@model CatalogViewModel
@{ ViewData["Title"] = "Tất cả điện thoại"; var brands = new[]{"Apple","Samsung","Xiaomi","OPPO","Google","vivo"}; }
<div class="container page-content"><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span> Điện thoại</div><div class="catalog-banner"><div><span class="section-kicker">KHÁM PHÁ CÔNG NGHỆ</span><h1>Tìm chiếc điện thoại<br/><em>dành riêng cho bạn.</em></h1><p>Từ flagship đỉnh cao đến lựa chọn thông minh cho mỗi ngày.</p></div><span class="catalog-spark">✦</span></div><div class="catalog-title"><div><h2>Điện thoại <span class="muted">(@Model.TotalCount sản phẩm)</span></h2><p>Khám phá và chọn điều bạn yêu thích.</p></div><form method="get" class="sort-form"><input type="hidden" name="search" value="@Model.Search"/><input type="hidden" name="brand" value="@Model.Brand"/><label for="sort">Sắp xếp:</label><select id="sort" name="sort" onchange="this.form.submit()"><option value="">Nổi bật</option><option value="price-asc" selected="@(Model.Sort == "price-asc")">Giá thấp đến cao</option><option value="price-desc" selected="@(Model.Sort == "price-desc")">Giá cao đến thấp</option><option value="name" selected="@(Model.Sort == "name")">Tên A–Z</option></select></form></div><div class="catalog-layout"><aside class="filter-panel"><h3>Bộ lọc sản phẩm</h3><div class="filter-label">THƯƠNG HIỆU</div><a class="filter-item @(string.IsNullOrEmpty(Model.Brand) ? "active" : "")" asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort">Tất cả <span>›</span></a>@foreach(var brand in brands){<a class="filter-item @(Model.Brand == brand ? "active" : "")" asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-brand="@brand">@brand <span>›</span></a>}<div class="filter-help"><span>✦</span><strong>Cần tư vấn chọn máy?</strong><p>Chúng tôi luôn sẵn sàng hỗ trợ bạn.</p><b>Liên hệ cửa hàng</b></div></aside><div><div class="mobile-filters">@foreach(var brand in brands){<a class="@(Model.Brand == brand ? "active" : "")" asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-brand="@brand">@brand</a>}</div>@if(Model.Products.Count == 0){<div class="empty-state"><span>⌕</span><h2>Chưa tìm thấy sản phẩm</h2><p>Hãy thử từ khóa hoặc bộ lọc khác.</p><a class="btn btn-primary" asp-action="Index">Xem tất cả sản phẩm</a></div>}else{<div class="product-grid catalog-products">@foreach(var product in Model.Products){<partial name="_ProductCard" model="product" />}</div>}@if(Model.TotalPages > 1){<div class="pagination">@for(var i=1;i<=Model.TotalPages;i++){<a class="@(i == Model.Page ? "active" : "")" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-brand="@Model.Brand" asp-route-sort="@Model.Sort">@i</a>}</div>}</div></div></div>
