@model CartViewModel
@{ ViewData["Title"] = "Giỏ hàng"; }
<div class="container page-content"><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span>Giỏ hàng</div><div class="page-heading"><span class="section-kicker">MUA SẮM DỄ DÀNG</span><h1>Giỏ hàng của bạn<span class="orange-dot">.</span></h1><p>@Model.Count sản phẩm đang chờ bạn.</p></div>@if(Model.Count == 0){<div class="empty-state"><span>♧</span><h2>Giỏ hàng đang trống</h2><p>Khám phá những chiếc điện thoại tuyệt vời đang chờ bạn.</p><a class="btn btn-primary" asp-controller="Products" asp-action="Index">Tiếp tục mua sắm ↗</a></div>}else{<div class="checkout-layout"><div class="cart-list">@foreach(var line in Model.Lines){<div class="cart-row"><div class="cart-mini-visual">@if (!string.IsNullOrWhiteSpace(line.Variant.ImageUrl)) { <img src="@line.Variant.ImageUrl" alt="@line.Product.Name" /> } else { <span class="cart-image-empty">Chưa có ảnh</span> }</div><div class="cart-product"><a asp-controller="Products" asp-action="Details" asp-route-slug="@line.Product.Slug">@line.Product.Name</a><small>@line.Variant.ColorName · @line.Variant.Storage</small><strong>@line.Variant.Price.ToString("N0")₫</strong></div><form asp-action="Update" method="post" class="cart-quantity"><input type="hidden" name="variantId" value="@line.Variant.Id"/><input type="number" name="quantity" value="@line.Quantity" min="0" max="@line.Variant.Stock" aria-label="Số lượng @line.Product.Name"/><button type="submit">Cập nhật</button></form><div class="cart-line-total">@line.Total.ToString("N0")₫</div><form asp-action="Remove" method="post"><input type="hidden" name="variantId" value="@line.Variant.Id"/><button class="remove-button" type="submit" aria-label="Xóa @line.Product.Name">×</button></form></div>}</div><aside class="summary-card"><h2>Tóm tắt đơn hàng</h2><div class="summary-line"><span>Tạm tính (@Model.Count sản phẩm)</span><strong>@Model.Total.ToString("N0")₫</strong></div><div class="summary-line"><span>Vận chuyển</span><strong class="free">@(Model.Total >= 5000000 ? "Miễn phí" : "Tính khi đặt hàng")</strong></div><div class="summary-total"><span>Tổng cộng</span><strong>@Model.Total.ToString("N0")₫</strong></div><a class="btn btn-primary full-width" asp-controller="Checkout" asp-action="Index">Tiến hành đặt hàng ↗</a><p>Thanh toán an toàn · Hỗ trợ tận tâm</p></aside></div><a class="back-link" asp-controller="Products" asp-action="Index">← Tiếp tục mua sắm</a>}</div>
