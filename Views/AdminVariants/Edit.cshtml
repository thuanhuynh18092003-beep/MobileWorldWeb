@model VariantEditViewModel
@{ var product = (Product)ViewBag.Product; var editing = Model.Id > 0; var colors = (List<VariantColor>)ViewBag.Colors; var storages = (List<VariantStorage>)ViewBag.Storages; ViewData["Title"] = editing ? "Sửa phiên bản" : "Thêm phiên bản"; }
<div class="container page-content admin-page management-page">
    <div class="page-heading"><span class="section-kicker">@product.Name</span><h1>@(editing ? "Chỉnh sửa phiên bản" : "Thêm màu và dung lượng")<span class="orange-dot">.</span></h1><p>Mỗi tổ hợp màu và dung lượng có ảnh, giá và tồn kho riêng. <a asp-controller="AdminVariantOptions" asp-action="Index">Quản lý danh mục màu và dung lượng ↗</a></p></div>
    @if (TempData["Success"] is string success) { <div class="notice success">@success</div> }
    <form asp-action="@(editing ? "Edit" : "Create")" asp-route-productId="@product.Id" asp-route-id="@(editing ? Model.Id : null)" method="post" enctype="multipart/form-data" class="form-panel admin-form"><div asp-validation-summary="All" class="validation"></div><div class="form-grid">
        <div class="field"><label asp-for="VariantColorId">Màu sắc *</label><select asp-for="VariantColorId" required><option value="0">Chọn màu</option>@foreach (var color in colors) { <option value="@color.Id">@color.Name</option> }</select><span asp-validation-for="VariantColorId" class="validation"></span></div>
        <div class="field"><label asp-for="VariantStorageId">Dung lượng *</label><select asp-for="VariantStorageId" required><option value="0">Chọn dung lượng</option>@foreach (var storage in storages) { <option value="@storage.Id">@storage.Name</option> }</select><span asp-validation-for="VariantStorageId" class="validation"></span></div>
        <div class="field"><label asp-for="Price">Giá bán (₫) *</label><input asp-for="Price" type="number" min="0" max="999999999" required /><span asp-validation-for="Price" class="validation"></span></div>
        <div class="field"><label asp-for="OldPrice">Giá cũ (₫)</label><input asp-for="OldPrice" type="number" min="0" max="999999999" /><span asp-validation-for="OldPrice" class="validation"></span></div>
        <div class="field"><label asp-for="Stock">Tồn kho *</label><input asp-for="Stock" type="number" min="0" max="100000" required /><span asp-validation-for="Stock" class="validation"></span></div>
        <div class="field field-wide product-image-field"><label for="imageFile">Ảnh của phiên bản này</label>@if (!string.IsNullOrEmpty(Model.ImageUrl)) { <div class="admin-image-preview"><img src="@Model.ImageUrl" alt="Ảnh phiên bản" /><span>Ảnh hiện tại</span></div><label class="remove-image-choice"><input type="checkbox" name="removeImage" value="true" /> Xóa ảnh hiện tại</label> }<input id="imageFile" name="imageFile" type="file" accept="image/jpeg,image/png,image/webp" /><small>JPG, PNG hoặc WebP, tối đa 5 MB. Chọn ảnh đúng màu để khách thấy máy đổi ảnh khi chọn biến thể.</small>@Html.ValidationMessage("imageFile", null, new { @class = "validation" })</div>
        <div class="field field-wide checkbox-row"><label><input asp-for="IsActive" /> Đang bán</label><label><input asp-for="IsDefault" /> Phiên bản mặc định</label></div>
    </div><div class="form-actions"><button class="btn btn-primary" type="submit">Lưu phiên bản</button><a class="btn btn-outline" asp-action="Index" asp-route-productId="@product.Id">Quay lại</a></div></form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
