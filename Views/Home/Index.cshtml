@model List<Product>
@{ ViewData["Title"] = "Điện thoại chính hãng, giá tốt"; }
<section class="hero burgundy-hero">
    <div class="container hero-grid">
        <div class="hero-copy">
            <span class="hero-kicker"><span class="pulse"></span> BURGUNDY GALAXY · iPHONE 18 PRO MAX</span>
            <h1>Định Hình Tương Lai<br/><em>Sắc Đỏ Burgundy<br class="mobile-title-break"/> Quyền Uy</em></h1>
            <p>Khám phá iPhone 18 Pro Max màu Burgundy qua mô hình 3D dựng theo thiết kế Apple công bố. Các sản phẩm đang bán nằm trong danh mục của cửa hàng.</p>
            <div class="hero-actions">
                <a class="btn btn-primary hero-buy" asp-controller="Products" asp-action="Index" asp-route-brand="Apple">Mua ngay <span>↗</span></a>
                <a class="hero-link" asp-controller="Products" asp-action="Index">Xem tất cả điện thoại <span>→</span></a>
            </div>
            <div class="hero-stats"><div><strong>100%</strong><span>Chính hãng</span></div><div><strong>12 tháng</strong><span>Bảo hành</span></div><div><strong>24h</strong><span>Giao nhanh</span></div></div>
        </div>
        <div class="hero-scene burgundy-hero-scene">
            <canvas id="hero-device-canvas" class="hero-device-canvas" aria-label="Mô hình 3D iPhone 18 Pro Max Burgundy xoay trong không gian"></canvas>
            <span class="hero-orbit orbit-one"></span><span class="hero-orbit orbit-two"></span>
            <div class="hero-device device-back" aria-hidden="true"><span class="device-camera"></span><span class="device-camera second"></span><span class="device-camera third"></span></div>
            <div class="hero-device device-front" aria-hidden="true"><span class="device-island"></span><span class="screen-glow"></span></div>
            <a class="hero-chip chip-top" href="https://www.apple.com/newsroom/2026/09/apple-debuts-iphone-18-pro-and-iphone-18-pro-max/" target="_blank" rel="noopener noreferrer"><span>✧</span> Theo thiết kế Apple ↗</a>
            <div class="hero-chip chip-bottom">iPhone 18 Pro Max <b>Burgundy · mô phỏng 3D</b></div>
        </div>
    </div>
</section>
<section class="service-strip"><div class="container service-grid"><div><span class="service-icon">↗</span><span><strong>Giao hàng miễn phí</strong><small>Đơn hàng từ 5 triệu</small></span></div><div><span class="service-icon">♢</span><span><strong>Cam kết chính hãng</strong><small>Nguồn gốc rõ ràng</small></span></div><div><span class="service-icon">◎</span><span><strong>Đổi trả dễ dàng</strong><small>Yên tâm mua sắm</small></span></div><div><span class="service-icon">◷</span><span><strong>Hỗ trợ tận tâm</strong><small>Luôn ở đây vì bạn</small></span></div></div></section>
<section class="technology-section container" aria-labelledby="technology-title">
    <div class="technology-copy"><span class="section-kicker">KHÁM PHÁ CÔNG NGHỆ</span><h2 id="technology-title">Một vũ trụ trải nghiệm.</h2><p>Chạm vào từng hành tinh để khám phá những yếu tố quan trọng khi chọn chiếc điện thoại tiếp theo.</p><strong id="technology-feature-title">Hiệu năng</strong><span id="technology-feature-description">Chọn cấu hình phù hợp cho công việc, giải trí và sáng tạo mỗi ngày.</span></div>
    <div class="technology-orbit" data-technology-orbit data-active="chip">
        <span class="technology-ring ring-one"></span><span class="technology-ring ring-two"></span>
        <svg class="technology-connections" viewBox="0 0 600 430" preserveAspectRatio="none" aria-hidden="true"><path class="connection-chip" d="M125 110 Q215 126 300 215"/><path class="connection-camera" d="M490 98 Q388 127 300 215"/><path class="connection-display" d="M470 350 Q385 290 300 215"/></svg>
        <span class="technology-phone" aria-hidden="true"><span></span></span>
        <button type="button" class="technology-planet planet-chip" data-technology="chip" aria-pressed="true"><span class="planet-sphere"></span><strong>Chipset</strong></button>
        <button type="button" class="technology-planet planet-camera" data-technology="camera" aria-pressed="false"><span class="planet-sphere"></span><strong>Camera</strong></button>
        <button type="button" class="technology-planet planet-display" data-technology="display" aria-pressed="false"><span class="planet-sphere"></span><strong>Màn hình</strong></button>
    </div>
</section>
<section class="section container"><div class="section-heading"><div><span class="section-kicker">LỰA CHỌN CỦA CHÚNG TÔI</span><h2>Điện thoại nổi bật<span class="orange-dot">.</span></h2><p>Những sản phẩm được yêu thích nhất tại MobileWorld.</p></div><a class="text-arrow" asp-controller="Products" asp-action="Index">Xem tất cả <span>↗</span></a></div><div class="product-grid">@foreach(var product in Model){<partial name="_ProductCard" model="product" />}</div></section>
<section class="promo-section"><div class="container promo-grid"><div class="promo-card promo-dark"><div><span class="section-kicker">ĐẲNG CẤP TRONG TẦM TAY</span><h2>iPhone.<br/>Nâng chuẩn mỗi ngày.</h2><p>Tinh tế trong từng chi tiết. Mạnh mẽ trong mọi trải nghiệm.</p><a asp-controller="Products" asp-action="Index" asp-route-brand="Apple">Khám phá ngay ↗</a></div><span class="promo-decoration">✦</span></div><div class="promo-card promo-light"><div><span class="section-kicker">SÁNG TẠO KHÔNG GIỚI HẠN</span><h2>Galaxy.<br/>Mở ra tương lai.</h2><p>Chạm vào những điều phi thường với công nghệ AI.</p><a asp-controller="Products" asp-action="Index" asp-route-brand="Samsung">Xem bộ sưu tập ↗</a></div><span class="promo-rings"></span></div></div></section>
<section class="brands-section container"><span class="section-kicker">THƯƠNG HIỆU HÀNG ĐẦU</span><h2>Tìm đúng chiếc máy dành cho bạn</h2><div class="brand-grid"><a asp-controller="Products" asp-action="Index" asp-route-brand="Apple">Apple <span>↗</span></a><a asp-controller="Products" asp-action="Index" asp-route-brand="Samsung">SAMSUNG <span>↗</span></a><a asp-controller="Products" asp-action="Index" asp-route-brand="Xiaomi">xiaomi <span>↗</span></a><a asp-controller="Products" asp-action="Index" asp-route-brand="OPPO">OPPO <span>↗</span></a><a asp-controller="Products" asp-action="Index" asp-route-brand="vivo">vivo <span>↗</span></a></div></section>
<section class="newsletter"><div class="container newsletter-inner"><div><span class="section-kicker">MOBILEWORLD</span><h2>Chọn công nghệ, chọn cảm hứng.</h2><p>Khám phá chiếc điện thoại tiếp theo của bạn ngay hôm nay.</p></div><a class="btn btn-white" asp-controller="Products" asp-action="Index">Mua sắm ngay ↗</a></div></section>
