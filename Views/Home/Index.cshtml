@model List<Product>
@{ ViewData["Title"] = "Điện thoại chính hãng, giá tốt"; }
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><span class="hero-kicker"><span class="pulse"></span> BỘ SƯU TẬP MỚI 2026</span><h1>Công nghệ trong tay.<br/><em>Phong cách của bạn.</em></h1><p>Khám phá những chiếc điện thoại được tuyển chọn cho mọi khoảnh khắc. Hiệu năng đỉnh cao, thiết kế khác biệt, giá luôn hấp dẫn.</p><div class="hero-actions"><a class="btn btn-primary" asp-controller="Products" asp-action="Index">Khám phá ngay <span>↗</span></a><a class="hero-link" asp-controller="Products" asp-action="Index" asp-route-brand="Apple">Xem iPhone mới <span>→</span></a></div><div class="hero-stats"><div><strong>100%</strong><span>Chính hãng</span></div><div><strong>12 tháng</strong><span>Bảo hành</span></div><div><strong>24h</strong><span>Giao nhanh</span></div></div></div><div class="hero-scene"><span class="hero-orbit orbit-one"></span><span class="hero-orbit orbit-two"></span><div class="hero-device device-back"><span class="device-camera"></span><span class="device-camera second"></span><span class="device-camera third"></span><span class="device-star">✦</span></div><div class="hero-device device-front"><span class="device-island"></span><span class="screen-glow"></span></div><div class="hero-chip chip-top"><span>✧</span> Nâng tầm trải nghiệm</div><div class="hero-chip chip-bottom">iPhone 16 Pro Max <b>33.990.000₫</b></div></div></div></section>
<section class="service-strip"><div class="container service-grid"><div><span class="service-icon">↗</span><span><strong>Giao hàng miễn phí</strong><small>Đơn hàng từ 5 triệu</small></span></div><div><span class="service-icon">♢</span><span><strong>Cam kết chính hãng</strong><small>Nguồn gốc rõ ràng</small></span></div><div><span class="service-icon">◎</span><span><strong>Đổi trả dễ dàng</strong><small>Yên tâm mua sắm</small></span></div><div><span class="service-icon">◷</span><span><strong>Hỗ trợ tận tâm</strong><small>Luôn ở đây vì bạn</small></span></div></div></section>
<section class="section container"><div class="section-heading"><div><span class="section-kicker">LỰA CHỌN CỦA CHÚNG TÔI</span><h2>Điện thoại nổi bật<span class="orange-dot">.</span></h2><p>Những sản phẩm được yêu thích nhất tại MobileWorld.</p></div><a class="text-arrow" asp-controller="Products" asp-action="Index">Xem tất cả <span>↗</span></a></div><div class="product-grid">@foreach(var product in Model){<partial name="_ProductCard" model="product" />}</div></section>
<section class="promo-section"><div class="container promo-grid"><div class="promo-card promo-dark"><div><span class="section-kicker">ĐẲNG CẤP TRONG TẦM TAY</span><h2>iPhone.<br/>Nâng chuẩn mỗi ngày.</h2><p>Tinh tế trong từng chi tiết. Mạnh mẽ trong mọi trải nghiệm.</p><a asp-controller="Products" asp-action="Index" asp-route-brand="Apple">Khám phá ngay ↗</a></div><span class="promo-decoration">✦</span></div><div class="promo-card promo-light"><div><span class="section-kicker">SÁNG TẠO KHÔNG GIỚI HẠN</span><h2>Galaxy.<br/>Mở ra tương lai.</h2><p>Chạm vào những điều phi thường với công nghệ AI.</p><a asp-controller="Products" asp-action="Index" asp-route-brand="Samsung">Xem bộ sưu tập ↗</a></div><span class="promo-rings"></span></div></div></section>
<section class="brands-section container"><span class="section-kicker">THƯƠNG HIỆU HÀNG ĐẦU</span><h2>Tìm đúng chiếc máy dành cho bạn</h2><div class="brand-grid"><a asp-controller="Products" asp-action="Index" asp-route-brand="Apple">Apple <span>↗</span></a><a asp-controller="Products" asp-action="Index" asp-route-brand="Samsung">SAMSUNG <span>↗</span></a><a asp-controller="Products" asp-action="Index" asp-route-brand="Xiaomi">xiaomi <span>↗</span></a><a asp-controller="Products" asp-action="Index" asp-route-brand="OPPO">OPPO <span>↗</span></a><a asp-controller="Products" asp-action="Index" asp-route-brand="vivo">vivo <span>↗</span></a></div></section>
<section class="newsletter"><div class="container newsletter-inner"><div><span class="section-kicker">MOBILEWORLD</span><h2>Chọn công nghệ, chọn cảm hứng.</h2><p>Khám phá chiếc điện thoại tiếp theo của bạn ngay hôm nay.</p></div><a class="btn btn-white" asp-controller="Products" asp-action="Index">Mua sắm ngay ↗</a></div></section>
